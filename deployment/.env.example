POSTGRES_DB=swebud
POSTGRES_USER=swebud
POSTGRES_PASSWORD=
# Helper/base images are locally verified immutable digests. Re-verify and
# update these deliberately when patching PostgreSQL/Alpine.
POSTGRES_IMAGE=postgres@sha256:4e6e670bb069649261c9c18031f0aded7bb249a5b6664ddec29c013a89310d50
POSTGRES_HELPER_IMAGE=postgres@sha256:4e6e670bb069649261c9c18031f0aded7bb249a5b6664ddec29c013a89310d50
MEDIA_HELPER_IMAGE=alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
CLAMAV_IMAGE=clamav/clamav@sha256:7f5389ccaa2368c383fa80e167ccfe44348d71e685f926fce4755eed1757673a

# deploy.sh creates three distinct, non-owner roles and URL-safe random
# passwords. DATABASE_URL is runtime-only; the admin and backup URLs must be
# used only by their named operational consumers.
DATABASE_RUNTIME_USER=swebud_runtime
DATABASE_RUNTIME_PASSWORD=
DATABASE_URL=
DATABASE_ADMIN_READONLY_USER=swebud_admin_readonly
DATABASE_ADMIN_READONLY_PASSWORD=
DATABASE_ADMIN_READONLY_URL=
DATABASE_BACKUP_USER=swebud_backup
DATABASE_BACKUP_PASSWORD=
DATABASE_BACKUP_URL=
# Required for Prisma migrate deploy when production DATABASE_URL uses a pooler.
# This must authenticate as a separate migration/object owner and is provided
# to production one-shot jobs only through a Compose secret file.
DIRECT_URL=
SWEBUD_NETWORK=swebud
SWEBUD_MODE=dev
# Set true only for the first production deployment when no project database
# volume or backend container exists. It is rejected once state exists.
SWEBUD_INITIAL_DEPLOY=false
# deploy.sh sets these to the current host IDs when omitted.
LOCAL_UID=
LOCAL_GID=
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=
ADMIN_JWT_ISSUER=swebudd-admin
ADMIN_JWT_AUDIENCE=swebudd-admin-moderation
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
MINIMUM_ACCOUNT_AGE=18
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
FRONTEND_ORIGIN=http://localhost:9000
ADMIN_ORIGIN=http://localhost:9100
ALLOW_LOCAL_ORIGINS=true
# Enable only for the signed Capacitor app transport.
NATIVE_AUTH_ENABLED=false
NATIVE_APP_ORIGIN=https://localhost
SWEBUDD_NATIVE_AUTH_EMERGENCY_DISABLED=false
LEGACY_NATIVE_AUTH_COMPAT_UNTIL=
LEGACY_WEB_AUTH_COMPAT_UNTIL=
BACKEND_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=55432
BACKEND_PORT=3002
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_IGNORE_TLS=true
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_IP_FAMILY=4
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SweBudd <no-reply@localhost>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/auth/google/callback
# Required and fail-closed when SWEBUD_MODE=prod; may remain empty for local dev.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
KLIPY_API_KEY=
KLIPY_CLIENT_KEY=swebud-local
MEDIA_STORAGE_DRIVER=local
# For S3 media storage:
# MEDIA_STORAGE_DRIVER=s3
# MEDIA_S3_BUCKET=swebudd-public-media
# MEDIA_QUARANTINE_S3_BUCKET=swebudd-private-quarantine
# MEDIA_S3_PREFIX=
# MEDIA_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/swebudd-media/
# AWS_REGION=ap-southeast-1
# AWS_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# AWS_S3_FORCE_PATH_STYLE=false
MEDIA_S3_PREFIX=
# Production Compose pins these security choices: S3 storage, worker enabled,
# legacy proxy disabled, and clamd over its internal-only Docker network.
MEDIA_S3_BUCKET=
MEDIA_QUARANTINE_S3_BUCKET=
MEDIA_PUBLIC_BASE_URL=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MEDIA_UPLOAD_MAX_ACTIVE_PER_USER=3
MEDIA_UPLOAD_ROLLING_QUOTA_BYTES=524288000
MEDIA_UPLOAD_ROLLING_QUOTA_HOURS=24
MEDIA_UPLOAD_PART_BYTES=8388608
MEDIA_UPLOAD_SESSION_TTL_SECONDS=1800
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_UPLOAD_WORKER_CONCURRENCY=2
MEDIA_UPLOAD_JOB_MAX_ATTEMPTS=5
MEDIA_UPLOAD_JOB_LEASE_SECONDS=300
MEDIA_UPLOAD_WORKER_POLL_MS=2000
MEDIA_S3_REQUEST_TIMEOUT_MS=30000
MEDIA_S3_DOWNLOAD_TIMEOUT_MS=180000
MEDIA_MULTIPART_COMPLETE_TIMEOUT_MS=120000
MEDIA_UPLOAD_COMPLETION_STALE_SECONDS=300
MEDIA_QUARANTINE_CLEANUP_TOMBSTONE_SECONDS=1800
MEDIA_PUBLISH_TIMEOUT_MS=120000
MEDIA_PUBLISH_CLEANUP_GRACE_SECONDS=1800
MEDIA_PUBLISH_CLEANUP_TOMBSTONE_SECONDS=300
MEDIA_PROCESSING_CONCURRENCY=2
MEDIA_PROCESSING_MAX_QUEUE=16
MEDIA_PROCESSING_STALE_TEMP_SECONDS=21600
MEDIA_PROCESSING_STALE_CLEANUP_LIMIT=100
MEDIA_MALWARE_SCAN_TIMEOUT_MS=60000

# Disaster recovery. Production deployment requires an encrypted checkpoint
# before every migration. BACKUP_OUTPUT_DIR must be absolute, owned by the
# backup account, non-symlinked, and mode 0700.
BACKUP_OUTPUT_DIR=/var/backups/swebudd
BACKUP_AGE_RECIPIENT=
# Backup hosts hold the owner-only Ed25519 private key. Restore/drill hosts hold
# only the pinned public key. Keep these as absolute non-symlink paths.
BACKUP_SIGNING_PRIVATE_KEY_FILE=
BACKUP_SIGNING_PUBLIC_KEY_FILE=
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_AWS_REGION=
BACKUP_S3_SSE=AES256
BACKUP_ALLOW_LOCAL_ONLY=false
# Set true only after lifecycle/object-lock policy has been verified on the
# offsite bucket. The local script enforces BACKUP_RETENTION_DAYS itself.
BACKUP_OFFSITE_RETENTION_CONFIRMED=false
BACKUP_RETENTION_DAYS=30
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4

# Absolute executable hook invoked with SWEBUDD_ALERT_* environment variables
# after a production deploy, backup, restore drill, or rollback failure.
FAILURE_ALERT_HOOK=

# Restore policy. BACKUP_AGE_IDENTITY_FILE is intentionally not stored here;
# pass its absolute private path only to restore-drill.sh. The pinned
# POSTGRES_HELPER_IMAGE and MEDIA_HELPER_IMAGE values above are also the
# executable allowlist for restore; a backup manifest must match them exactly.
RESTORE_EXPECTED_PROJECT=swebud
RESTORE_EXPECTED_DATABASE_NAME=swebud
RESTORE_MAX_RPO_HOURS=24
RESTORE_MAX_RTO_HOURS=4
# Explicit one-command acknowledgement required by rollback-image.sh. Leave
# empty until migration compatibility has been reviewed for a real rollback.
ROLLBACK_SCHEMA_COMPATIBILITY_ACK=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

MAILHOG_SMTP_PORT=1126
MAILHOG_UI_PORT=8126
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:9000/auth/google/callback

# Production subdomain layout example:
# FRONTEND_ORIGIN=https://swebudd.com
# ADMIN_ORIGIN= # Keep empty until an admin site has a public HTTPS origin.
# GOOGLE_CALLBACK_URL=https://api.swebudd.com/auth/google/callback
# GOOGLE_OAUTH_REDIRECT_URI=https://swebudd.com/auth/google/callback
# Production mode refuses known/default secrets, local origins, MailHog, and
# plaintext SMTP. Set a real SMTP host, verified MAIL_FROM, TLS options, and
# distinct random JWT secrets before running `SWEBUD_MODE=prod deploy.sh`.
