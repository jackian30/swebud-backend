# Local Docker default:
DATABASE_URL="postgresql://swebud:swebud@localhost:55432/swebud?schema=public"
# Render + Supabase Free Postgres example. Keep low connection limits on the shared pooler.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=3"
# DIRECT_URL is required for Prisma migrations on Render/Supabase. Prefer direct DB when it is reachable over IPv4; otherwise use Supabase session pooler, not transaction pooler.
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1"
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too"
# Admin moderation JWTs are minted by a trusted identity service, use HS256,
# require MFA/scopes, and must expire within 300 seconds.
ADMIN_JWT_SECRET="local-admin-moderation-secret-not-for-production"
ADMIN_JWT_ISSUER="swebudd-admin"
ADMIN_JWT_AUDIENCE="swebudd-admin-moderation"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
MINIMUM_ACCOUNT_AGE=18
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
FRONTEND_ORIGIN="http://localhost:9000"
ADMIN_ORIGIN="http://localhost:9100"
ALLOW_LOCAL_ORIGINS=true
NATIVE_AUTH_ENABLED=false
NATIVE_APP_ORIGIN="https://localhost"
SWEBUDD_NATIVE_AUTH_EMERGENCY_DISABLED=false
LEGACY_NATIVE_AUTH_COMPAT_UNTIL=""
LEGACY_WEB_AUTH_COMPAT_UNTIL=""
PORT=3000
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_IGNORE_TLS=true
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="SweBudd <no-reply@localhost>"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:9000/auth/google/callback"
# Required and fail-closed in production; may remain empty only in local development.
CLOUDFLARE_TURNSTILE_SECRET_KEY=""

# Production subdomain layout example:
# FRONTEND_ORIGIN="https://swebudd.com"
# ADMIN_ORIGIN="" # Keep empty until an admin site has a public HTTPS origin.
# GOOGLE_CALLBACK_URL="https://api.swebudd.com/auth/google/callback"
# GOOGLE_OAUTH_REDIRECT_URI="https://swebudd.com/auth/google/callback"
KLIPY_API_KEY=""
KLIPY_CLIENT_KEY="swebud-local"
MEDIA_STORAGE_DRIVER="local"
# For S3 media storage:
# MEDIA_STORAGE_DRIVER="s3"
# MEDIA_S3_BUCKET=""
# MEDIA_S3_PREFIX=""
# MEDIA_PUBLIC_BASE_URL="https://cdn.example.com/"
# AWS_REGION="us-east-1"
# AWS_S3_ENDPOINT=""
# AWS_S3_FORCE_PATH_STYLE="false"
# Supabase Storage S3 example:
# MEDIA_STORAGE_DRIVER="s3"
# MEDIA_S3_BUCKET="swebudd-media"
# MEDIA_S3_PREFIX=""
# MEDIA_PUBLIC_BASE_URL="https://<project-ref>.supabase.co/storage/v1/object/public/swebudd-media/"
# AWS_REGION="ap-southeast-1"
# AWS_S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
# AWS_S3_FORCE_PATH_STYLE="true"
# AWS_ACCESS_KEY_ID="<supabase-storage-access-key>"
# AWS_SECRET_ACCESS_KEY="<supabase-storage-secret-key>"
# Cloudflare R2 example:
# MEDIA_STORAGE_DRIVER="s3"
# MEDIA_S3_BUCKET="<bucket-name>"
# MEDIA_S3_PREFIX=""
# MEDIA_PUBLIC_BASE_URL="https://media.your-domain.com/"
# AWS_REGION="auto"
# AWS_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# AWS_S3_FORCE_PATH_STYLE="true"
# AWS_ACCESS_KEY_ID="<r2-access-key-id>"
# AWS_SECRET_ACCESS_KEY="<r2-secret-access-key>"
# Uploads v2 always uses a separate private quarantine bucket.
MEDIA_S3_PREFIX=""
MEDIA_QUARANTINE_S3_BUCKET=""
MEDIA_UPLOAD_WORKER_ENABLED=false
MEDIA_LEGACY_PROXY_UPLOADS_ENABLED=true
MEDIA_PROCESSING_TEMP_DIR=""
MEDIA_UPLOAD_MAX_ACTIVE_PER_USER=3
MEDIA_UPLOAD_ROLLING_QUOTA_BYTES=524288000
MEDIA_UPLOAD_ROLLING_QUOTA_HOURS=24
MEDIA_UPLOAD_PART_BYTES=8388608
MEDIA_UPLOAD_SESSION_TTL_SECONDS=1800
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_UPLOAD_WORKER_CONCURRENCY=2
MEDIA_UPLOAD_JOB_MAX_ATTEMPTS=5
MEDIA_UPLOAD_JOB_LEASE_SECONDS=300
MEDIA_UPLOAD_WORKER_POLL_MS=2000
MEDIA_S3_REQUEST_TIMEOUT_MS=30000
MEDIA_S3_DOWNLOAD_TIMEOUT_MS=180000
MEDIA_MULTIPART_COMPLETE_TIMEOUT_MS=120000
MEDIA_UPLOAD_COMPLETION_STALE_SECONDS=300
MEDIA_QUARANTINE_CLEANUP_TOMBSTONE_SECONDS=1800
MEDIA_PUBLISH_TIMEOUT_MS=120000
MEDIA_PUBLISH_CLEANUP_GRACE_SECONDS=1800
MEDIA_PUBLISH_CLEANUP_TOMBSTONE_SECONDS=300
MEDIA_PROCESSING_CONCURRENCY=2
MEDIA_PROCESSING_MAX_QUEUE=16
MEDIA_PROCESSING_STALE_TEMP_SECONDS=21600
MEDIA_PROCESSING_STALE_CLEANUP_LIMIT=100
# Local development may disable scanning; production validation rejects it.
MEDIA_MALWARE_SCANNER="disabled"
MEDIA_MALWARE_SCAN_TIMEOUT_MS=60000
MEDIA_CLAMDSCAN_PATH="clamdscan"
# Direct clamd TCP is unencrypted/unauthenticated and private-network only.
MEDIA_CLAMD_TCP_HOST=""
MEDIA_CLAMD_TCP_PORT=3310
MEDIA_CLAMD_TRUSTED_NETWORK=false
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_WEBHOOK_VERIFY_TOKEN=""
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
